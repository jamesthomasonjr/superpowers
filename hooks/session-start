#!/usr/bin/env bash
# SessionStart hook for supersuit plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-superpowers content
using_superpowers_content=$(cat "${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md" 2>&1 || echo "Error reading using-superpowers skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_superpowers_escaped=$(escape_for_json "$using_superpowers_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have Supersuit (Superpowers-compatible skills).\n\n**Below is the full content of your 'supersuit:using-superpowers' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_superpowers_escaped}\n</EXTREMELY_IMPORTANT>"

workflow_map_header_agent="\n<WORKFLOW_MAP>\nHandoffs are authoritative. Skills are terminal — do not invent next skills.\nAfter a skill completes, use (from, on) -> to from this map.\nto: <id> invokes that logical id (resolve via skills registry: run/exec, then path, then skill alias, else same name).\nIf the registry entry has run/exec, execute scripts/run-workflow-action --id <id> (or equivalent harness exec with the same argv/allow rules). The executor always re-probes host capabilities (same conservative detect as SessionStart) and honors SUPERPOWERS_CAPABILITIES / --capabilities; when this JSON lists capabilities, pass them as --capabilities so advertised tokens cannot drop. Use the JSON outcome as on for the next lookup.\nto: null means no pipeline handoff; continue the session (description-triggered skills still apply).\nto: wait means stop and ask the human.\nMissing outcome in the map: treat as wait.\n\nRESOLVED_JSON\n"

workflow_map_header_host="\n<WORKFLOW_MAP>\nHandoffs are authoritative. Skills are terminal — do not invent next skills.\nAfter a skill completes, use (from, on) -> to from this map.\nto: <id> invokes that logical id (resolve via skills registry: run/exec, then path, then skill alias, else same name).\nHOST_EXEC: exec-hook is advertised. If the registry entry has run/exec, do not invent argv and do not construct the program command line. The host executes hooks/workflow-exec --id <id> (or --from <completed-id> --on <outcome>) and forwards this JSON's capabilities as --capabilities. Claude Code: Stop hook. Cursor: injected tool (sessionStart is not exec-hook). The mediator always goes through run-workflow-action (same allowlist/outcome contract). Use the JSON outcome as on for the next lookup. If the host has not fired, trigger hooks/workflow-exec with --id or --from/--on only.\nto: null means no pipeline handoff; continue the session (description-triggered skills still apply).\nto: wait means stop and ask the human.\nMissing outcome in the map: treat as wait.\n\nRESOLVED_JSON\n"

workflow_map_header_for() {
    local json="$1"
    if printf '%s' "$json" | python3 -c 'import json,sys
try:
    data = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if "exec-hook" in (data.get("capabilities") or []) else 1)'; then
        printf '%s' "$workflow_map_header_host"
    else
        printf '%s' "$workflow_map_header_agent"
    fi
}

workflow_suffix=""
resolve_caps=(--detect-capabilities)
if resolved_json=$("${PLUGIN_ROOT}/scripts/resolve-workflow" \
    --plugin-root "${PLUGIN_ROOT}" \
    --project-root "${PWD}" \
    --user-home "${HOME}" \
    "${resolve_caps[@]}" 2>/dev/null); then
    resolved_json_escaped=$(escape_for_json "$resolved_json")
    workflow_map_header="$(workflow_map_header_for "$resolved_json")"
    workflow_suffix="${workflow_map_header}${resolved_json_escaped}\n</WORKFLOW_MAP>"
elif resolved_json=$("${PLUGIN_ROOT}/scripts/resolve-workflow" \
    --plugin-root "${PLUGIN_ROOT}" \
    --project-root "${PWD}" \
    --user-home "${HOME}" \
    --bundled-only \
    "${resolve_caps[@]}" 2>/dev/null); then
    resolved_json_escaped=$(escape_for_json "$resolved_json")
    workflow_map_header="$(workflow_map_header_for "$resolved_json")"
    workflow_suffix="\nWORKFLOW_CONFIG_WARNING: workflow overlay invalid or resolve failed; using bundled defaults only.${workflow_map_header}${resolved_json_escaped}\n</WORKFLOW_MAP>"
else
    workflow_suffix="\nWORKFLOW_CONFIG_WARNING: workflow resolve failed (including bundled defaults); no WORKFLOW_MAP available. Do not invent handoffs — ask the human."
fi
session_context="${session_context}${workflow_suffix}"

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
